<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<smil>
	<head>
		<meta name="title" content="Testing seq media with repeats" />
		<layout>
			<root-layout id="display:0" width="1920" height="1080" />
			<region regionName="screen" top="0" left="0" width="1920" height="1080" z-index="1" backgroundColor="#000" mediaAlign="center"/>
		</layout>
	</head>
	<body>
	
	<!--
	    Just for random smil testing
	-->
	
		<img xml:id="img_begin" src="../images/begin.jpg" dur="1s"  />
		<seq xml:id="seq1">
			<video src="/home/niko/.cache/garlic-player/1e44d740bcc945df999982a24f515990.mp4" mediaAlign="center"/>
		</seq>
		<img xml:id="img_end" src="../images/end.jpg" dur="1s" />
	</body>
</smil>
